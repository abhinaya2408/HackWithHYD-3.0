# ============================================================
# PulseMind environment configuration
# Copy this file to `.env` and fill in your own values.
# `.env` is gitignored — never commit real keys.
# ============================================================

# --- Groq (REQUIRED) -----------------------------------------
# Free API key: https://console.groq.com/keys
# Used twice on purpose:
#   1. by Hindsight for memory extraction/consolidation
#   2. by PulseMind's own agent for themes, reasoning and recommendations
GROQ_API_KEY=

# PulseMind's REASONING model: theme extraction, insights, recommendations.
# `openai/gpt-oss-120b` is the model the Hindsight docs recommend for Groq.
# Free-tier limits are per model (30 RPM, 8k TPM, 200k TPD for gpt-oss models).
# Note: the Llama models moved to Enterprise-only in Aug 2026 and are no longer on
# the free tier, so do not swap to llama-3.x here.
GROQ_MODEL=openai/gpt-oss-120b

# Hindsight's OWN model: used for fact extraction and observation consolidation.
# Kept different from GROQ_MODEL on purpose. Groq enforces rate limits per model,
# so this gives the memory workload a separate tokens-per-minute budget instead of
# fighting PulseMind's reasoning calls for the same 8k TPM. One extraction costs
# ~4.3k tokens, so Hindsight can sustain ~2 per minute on this budget alone.
HINDSIGHT_LLM_MODEL=openai/gpt-oss-20b
# Hindsight runs two separate Groq workloads. Fact extraction (RETAIN) uses
# HINDSIGHT_LLM_MODEL; post-retain consolidation is moved to its own model below so the
# two never share a free-tier TPM budget. Each Groq model has a separate TPM allowance.
HINDSIGHT_API_CONSOLIDATION_LLM_MODEL=qwen/qwen3.8-27b

# --- Hindsight -------------------------------------------------
# Which memory bank PulseMind writes to and recalls from.
HINDSIGHT_BANK_ID=pulsemind

# embedded (default, zero-cost): PulseMind starts a Hindsight server in-process
#   with an embedded PostgreSQL. No Docker, no cloud account.
# remote: point PulseMind at a Hindsight server you already run
#   (e.g. `docker run -p 8888:8888 ghcr.io/vectorize-io/hindsight:latest`)
HINDSIGHT_MODE=embedded

# Only used when HINDSIGHT_MODE=remote
HINDSIGHT_BASE_URL=http://localhost:8888
# Only used when HINDSIGHT_MODE=remote and that server requires auth
HINDSIGHT_API_KEY=

# Hindsight runs its own LLM calls (extraction, observation consolidation).
# These override what PulseMind passes to the embedded server.
HINDSIGHT_LLM_PROVIDER=groq

# Groq "service tier" Hindsight requests on its internal LLM calls.
# Hindsight 0.10.1 defaults to "auto", which some Groq organisations reject with
# HTTP 400 ("`service_tier` `auto` is not available for this org"). When that
# happens RETAIN fails with "Fact extraction failed", because no memory can be
# written. "on_demand" is the standard tier and works on the free plan.
# Valid values: on_demand | flex | auto
HINDSIGHT_API_LLM_GROQ_SERVICE_TIER=on_demand

# --- Free-tier pacing ------------------------------------------
# Minimum seconds between two operations that make Hindsight call its LLM.
# Each extraction costs ~4.3k tokens against an 8k tokens/minute budget, so two per
# minute is the hard ceiling. 30s stays under it and avoids RETAINs that fail with
# HTTP 429 and have to be retried (a retried RETAIN is a wasted call).
# Set to 0 on a paid tier to retain as fast as possible.
PULSEMIND_RETAIN_PACE_SECONDS=30

# --- Demo data -------------------------------------------------
# Directory holding feedback.csv and product_changes.csv
PULSEMIND_DATA_DIR=data
# Server-wide Hindsight switch: no automatic background consolidation after RETAIN.
# Keeps the free-tier TPM budget for extraction and reasoning; observations can still be
# built on demand via POST /banks/{bank_id}/consolidate.
HINDSIGHT_API_ENABLE_AUTO_CONSOLIDATION=false

# ---- GitHub (optional, read-only) -------------------------------------------
# When engineering merges a PR or publishes a release, PulseMind retains it as a
# product-change memory. Webhook deliveries are verified with the secret below.
# GITHUB_TOKEN needs read-only public-repo access only (or leave empty for public repos).
# Run the receiver:  python -m core.github_webhook
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=
GITHUB_REPO_OWNER=
GITHUB_REPO_NAME=
GITHUB_WEBHOOK_HOST=127.0.0.1
GITHUB_WEBHOOK_PORT=8765
